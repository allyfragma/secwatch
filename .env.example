# Copy to .env on the server (never commit .env). Only SECWATCH_WEB_PASSWORD is required.
# With the systemd install, `sudo secwatch setup` writes /etc/secwatch/secwatch.env for you.

# Language of the dashboard and alerts: en or ru.
SECWATCH_LANG=en

# Dashboard login (HTTP Basic). Use a long random password.
SECWATCH_WEB_USER=admin
SECWATCH_WEB_PASSWORD=

# Day boundaries and display time zone; timezone of syslog lines without offset.
SECWATCH_TIMEZONE=UTC
SECWATCH_SYSLOG_TZ=UTC
SECWATCH_POLL_SECONDS=30

# Telegram alerts (create a SEPARATE bot via @BotFather; do not reuse a production bot token).
SECWATCH_TELEGRAM_TOKEN=
SECWATCH_TELEGRAM_CHAT_ID=
SECWATCH_DIGEST_HOUR=9
SECWATCH_SPIKE_THRESHOLD=60

# Supabase Management API (read-only use). Personal access token sbp_... and project ref.
SECWATCH_SUPABASE_TOKEN=
SECWATCH_SUPABASE_PROJECT_REF=
SECWATCH_SUPABASE_POLL_MINUTES=15
SECWATCH_SUPABASE_AUTH_LOGS=1

# Own IPs/networks that are not attackers ("ip-or-cidr label; ..."), or a file (default allowlist.txt):
# SECWATCH_ALLOWLIST=203.0.113.5 office; 198.51.100.0/24 VPN
# SECWATCH_ALLOWLIST_FILE=/data/allowlist.txt
# System log for notable and new kinds of events; days to learn what is normal first:
# SECWATCH_SYSLOG_LOGS=/host/var/log/syslog
# SECWATCH_RARE_LEARNING_DAYS=3

# Optional overrides (defaults shown)
# SECWATCH_AUTH_LOGS=/host/var/log/auth.log
# SECWATCH_NGINX_LOGS=/host/var/log/nginx/access.log
# SECWATCH_FAIL2BAN_LOGS=/host/var/log/fail2ban.log
# Country/ASN: free DB-IP Lite is downloaded into the data dir automatically (0 = off).
# SECWATCH_GEOIP_AUTO_UPDATE=1
# Optional MaxMind files take precedence when present:
# SECWATCH_GEOIP_COUNTRY_DB=/data/GeoLite2-Country.mmdb
# SECWATCH_GEOIP_ASN_DB=/data/GeoLite2-ASN.mmdb

# Caddy JSON access log
# SECWATCH_CADDY_LOGS=/host/var/log/caddy/access.json

# Optional: send alerts and summaries to your own app over HTTP (Bearer key), e.g.
# http://127.0.0.1:3000/api/security/ingest
SECWATCH_ERP_INGEST_URL=
SECWATCH_ERP_INGEST_KEY=
